- name: Wait until all addons are available
  vars:
    addons:
      - application-manager
      - governance-policy-framework
      - cluster-proxy
  ansible.builtin.command:
    cmd: >-
      kubectl get managedclusteraddon {{ addon }}
      -n asd
      --kubeconfig /tmp/asd
      -o jsonpath='{.status.conditions[?(@.type=="Available")].status}'
  loop: "{{ addons }}"
  loop_control:
    loop_var: addon
  register: addon_status
  until: addon_status.stdout == "True"
  retries: 30
  delay: 10
  changed_when: false
