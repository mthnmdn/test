NS=grpc-test
APP_LABEL="app=pygrpc"
METHOD="greeter.Greeter/SayHello"

for pod in $(oc get pod -n "$NS" -l "$APP_LABEL" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'); do
  count=$(oc logs -n "$NS" "$pod" -c istio-proxy --since=10m | grep -c "$METHOD")
  echo "$pod: $count"
done

---

oc get pods --all-namespaces -o jsonpath='{range .items[*]}{range .spec.containers[*]}{$.metadata.namespace}{"\t"}{$.metadata.name}{"\t"}{.name}{"\t"}{.resources.requests.cpu}{"\n"}{end}{end}' \
| awk -F'\t' '{c=$4; if(c ~ /m$/){sub(/m$/,"",c)} else if(c!=""){c=c*1000} print c"\t"$0}' \
| sort -k1 -nr | cut -f2-


oc get configmap user-ca-bundle -n openshift-config -o jsonpath='{.data.ca-bundle\.crt}' | awk -v cmd='openssl x509 -noout -subject -issuer' '/BEGIN/{close(cmd)};{print | cmd}'


apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: system-namespace-resource-usage
  namespace: openshift-monitoring
  labels:
    role: alert-rules
spec:
  groups:
  - name: system-namespace-usage.rules
    rules:
    - alert: SystemPodHighCPUUsage
      expr: |
        sum by (namespace, pod) (
          rate(container_cpu_usage_seconds_total{namespace=~"openshift-.*|kube-.*|default"}[5m])
        ) > 0.8
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: "Yüksek CPU kullanımı: {{ $labels.namespace }}/{{ $labels.pod }}"
        description: "{{ $labels.pod }} pod'u ({{ $labels.namespace }}) son 10 dakikadır 0.8 core üzerinde CPU kullanıyor. Mevcut: {{ $value | printf \"%.2f\" }} core."

    - alert: SystemPodHighMemoryUsage
      expr: |
        sum by (namespace, pod) (
          container_memory_working_set_bytes{namespace=~"openshift-.*|kube-.*|default", container!=""}
        ) > 2 * 1024 * 1024 * 1024
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: "Yüksek memory kullanımı: {{ $labels.namespace }}/{{ $labels.pod }}"
        description: "{{ $labels.pod }} pod'u ({{ $labels.namespace }}) 2Gi üzerinde memory kullanıyor. Mevcut: {{ $value | humanize1024 }}B."

---

oc get prometheusrule -A -o json | jq -r '.items[].spec.groups[].rules[] | select(.record=="pod:container_cpu_usage:sum") | .expr'

---
MEMORY EXPR
---
expr: sum(container_memory_working_set_bytes{container="", pod!=""}) BY (pod, namespace) > 100 * 1024 * 1024 * 1024
for: 5m
annotations:
  summary: "Pod {{ $labels.pod }} yüksek memory kullanıyor ({{ $labels.namespace }})"

CPU EXPR
---
expr: sum(rate(container_cpu_usage_seconds_total{container="", pod!=""}[5m])) BY (pod, namespace) > 10
for: 5m
annotations:
  summary: "Pod {{ $labels.pod }} yüksek CPU kullanıyor ({{ $labels.namespace }})"
  description: "{{ $labels.namespace }}/{{ $labels.pod }} pod'u 5 dakikadır 10 core üzerinde CPU kullanıyor. Güncel kullanım: {{ $value | humanize }} core"
  description: "{{ $labels.namespace }}/{{ $labels.pod }} pod'u 5 dakikadır 100 GiB üzerinde memory kullanıyor. Güncel kullanım: {{ $value | humanize1024 }}B"

---

oc -n openshift-monitoring get secret alertmanager-main --template='{{ index .data "alertmanager.yaml" | base64decode }}' > alertmanager.yaml

oc -n openshift-monitoring set data secret/alertmanager-main --from-file=alertmanager.yaml=alertmanager.yaml

---

route:
  receiver: 'email-receiver'
  group_by: ['namespace', 'pod']
  repeat_interval: 4h          # genel varsayılan
  routes:
    - matchers:
        - alertname =~ "Yüksek(Memory|CPU)Kullanımı"
      receiver: 'email-receiver'
      repeat_interval: 1h      # bu alarmlar için daha sık

---

policies:
  - name: high-pod-resource-usage
    manifests:
      - path: high-pod-resource-usage.yaml
    patches:
      - apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: high-pod-resource-usage
          annotations:
            policy.open-cluster-management.io/disable-templates: "true"

---

while read -r cluster; do [ -z "$cluster" ] && continue; oc label managedcluster "$cluster" my-label=my-value --overwrite; done < clusters.txt
